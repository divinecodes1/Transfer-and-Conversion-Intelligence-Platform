# Transfer & Conversion Intelligence Platform :: local demo configuration.
#
#   cp .env.example .env
#
# Every value here is a throwaway credential for containers bound to localhost.
# They live in one file rather than scattered across source, manifests and docs
# for two reasons: a reader can see the whole trust model at a glance, and
# nothing in the repository has to be edited to point at a real deployment.
#
# In a real deployment none of this is a file: the DSNs come from the platform's
# secret store, and the three database roles below keep their separation --
# that separation is the security design, not the passwords.

# ---- Warehouse ------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=dev
POSTGRES_DB=transferops

# The loader. Owns the schema, entitled to the whole portfolio.
TRANSFEROPS_DSN=postgresql://app:dev@localhost:5432/transferops

# The API. A NON-SUPERUSER, SELECT-only role -- this is load-bearing rather than
# tidy, because PostgreSQL superusers bypass row-level security unconditionally
# and every entitlement policy would be installed but inert.
TRANSFEROPS_API_DSN=postgresql://transferops_reader:reader@localhost:5432/transferops

# The assistant's audit trail. INSERT on one table and nothing else, so a
# compromised assistant still cannot read a project row or alter a metric.
TRANSFEROPS_AUDIT_DSN=postgresql://transferops_auditor:auditor@localhost:5432/transferops

# The AI cache writer. It can write generated narratives, risk estimates and
# refresh history in tr_ai, but cannot read CORE, METRIC or MART directly.
TRANSFEROPS_AI_DSN=postgresql://transferops_ai:ai@localhost:5432/transferops

# The passwords the loader installs on those two roles. They are NOT written in
# sql/10_rls.sql or sql/11_observability.sql -- a credential in version control is
# a credential published with the repository. Loading a non-local database with
# these unset is a hard failure rather than a silent default.
TRANSFEROPS_READER_PASSWORD=reader
TRANSFEROPS_AUDITOR_PASSWORD=auditor
TRANSFEROPS_AI_PASSWORD=ai

# ---- Services -------------------------------------------------------------
TRANSFEROPS_API=http://127.0.0.1:8000

# enforce = only a verified Keycloak token is accepted; X-Demo-User is refused
#           and unauthenticated callers get 401. THIS IS THE DEFAULT: if the
#           variable is unset, the platform enforces.
# demo    = X-Demo-User is honoured and unauthenticated callers get the admin
#           identity. Local convenience only -- never expose it beyond localhost.
#           Every process logs a warning while it is on.
TRANSFEROPS_AUTH=enforce

# ---- AI (optional) --------------------------------------------------------
# Leave the key empty to keep every dashboard and the deterministic assistant
# working without model calls. anthropic uses the official SDK; openai uses the
# OpenAI-compatible chat-completions contract and supports hosted or local models.
TRANSFEROPS_AI_PROVIDER=anthropic
TRANSFEROPS_AI_MODEL=claude-opus-5
TRANSFEROPS_AI_API_KEY=
TRANSFEROPS_AI_BASE_URL=
TRANSFEROPS_AI_MAX_TOKENS=4000
TRANSFEROPS_AI_TIMEOUT=120
TRANSFEROPS_AI_TTL_HOURS=24

# Required before enabling the signed /ai/refresh endpoint. Unset means the
# endpoint refuses every request rather than defaulting to open -- it is the one
# endpoint that spends money.
TRANSFEROPS_AI_CRON_SECRET=

# The identity the scheduled refresh runs as. Its entitlements bound every scope
# the job can warm, so a narrower identity produces fewer cached narratives
# rather than a leak.
TRANSFEROPS_AI_IDENTITY=admin

# ---- The console (web/) ----------------------------------------------------
# In development the Vite dev server proxies /api and /assistant to these, so the
# browser only ever talks to its own origin and holds no credential of its own.
# In a deployment the same paths are served by an ingress rule and these are unset.
TRANSFEROPS_AGENT=http://127.0.0.1:8100

# The browser uses Authorization Code + PKCE against Keycloak. Set this to demo
# only when deliberately running the unauthenticated X-Demo-User quickstart.
VITE_TRANSFEROPS_AUTH=enforce
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=transferops
VITE_KEYCLOAK_CLIENT_ID=transferops-api

# ---- Logging ---------------------------------------------------------------
# json (default) | text.  Structured by default so an incident is searchable.
TRANSFEROPS_LOG_FORMAT=text
TRANSFEROPS_LOG_LEVEL=INFO

# ---- Optional -------------------------------------------------------------
# Retrieval runs in-process when this is empty; set it to use the container.
TRANSFEROPS_QDRANT=

# hashed | sentence-transformers
TRANSFEROPS_EMBEDDER=hashed

# ---- Identity provider (optional, `make sso-up`) ---------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=transferops
KEYCLOAK_AUDIENCE=transferops-api

# Local development sends verification and reset messages to Mailpit, visible at
# http://localhost:8025. Replace these with the organisation's approved SMTP
# relay in deployed environments; do not commit the SMTP password.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@transferops.local
KEYCLOAK_SMTP_REPLY_TO=support@transferops.local
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=false

# ---- Observability (optional, `make obs-up`) -------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
