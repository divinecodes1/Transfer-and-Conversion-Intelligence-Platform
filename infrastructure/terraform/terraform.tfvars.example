# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
# Secrets do NOT belong here even though Terraform would accept them. Pass them
# as environment variables so they never reach a file that can be committed:
#
#   export ARM_SUBSCRIPTION_ID="..."
#   export TF_VAR_ai_api_key="sk-..."
#   export TF_VAR_image_registry_password="ghp_..."

# ---- Required --------------------------------------------------------------
subscription_id = "00000000-0000-0000-0000-000000000000"

# ---- Naming and region -----------------------------------------------------
prefix      = "ti"
environment = "student"
location    = "westeurope"
owner       = "your-name"

# ---- Budget: set this, it is the only early warning you get -----------------
# Thresholds fire at 50/75/90/100% of the amount, so 30 warns at 15, 22.50, 27
# and 30, plus a forecast alert before the spend actually happens.
#
# Monthly  -- resets on the 1st; alarms on a bad month (a replica left warm).
# Annually -- does not reset; alarms on CUMULATIVE spend, which is how a student
#             credit actually runs out: twelve quiet months at 8 USD never trip
#             a monthly threshold and still empty a 100 USD credit.
monthly_budget_amount = 30
budget_time_grain     = "Monthly"
budget_alert_emails   = ["you@university.edu"]

# ---- Database --------------------------------------------------------------
# Your public IP, so the loader can reach the server from this machine.
#   curl -s https://api.ipify.org
allowed_client_ip = ""

# ---- Images ----------------------------------------------------------------
# Default path is a public GHCR image and no Azure Container Registry, which
# avoids a fixed ~5 USD/month charge. deploy-azure-student.sh rewrites this.
api_image             = "ghcr.io/OWNER/transfer-intelligence:latest"
use_acr               = false
image_registry_server = ""

# ---- Identity (Keycloak) ----------------------------------------------------
# Keycloak runs as its own Container App with its own database on the shared
# server. The realm, themes, self-registration and recovery flows are the same
# ones that run locally under docker compose.
#
# keycloak_min_replicas = 0 keeps it free at idle and costs a 40-60 second cold
# start on the first sign-in. Set it to 1 for the duration of a live demo, then
# set it back -- held warm it is roughly a third of the student credit a month.
keycloak_min_replicas = 0
keycloak_realm        = "transferops"
keycloak_audience     = "transferops-api"
auth_mode             = "enforce"

# ---- AI --------------------------------------------------------------------
# "mock" is the default and needs no key, no credits and no provider account.
# The console's AI surfaces all work; the narratives are computed deterministically
# from the governed data rather than generated.
ai_provider = "mock"

# OpenAI:
#   ai_provider = "openai"
#   ai_model    = "gpt-4o-mini"
#   export TF_VAR_ai_api_key="sk-..."
#
# Azure OpenAI reuses the OpenAI-compatible adapter -- no separate provider:
#   ai_provider = "openai"
#   ai_base_url = "https://<resource>.openai.azure.com/openai/deployments/<deployment>"
#   ai_model    = "<deployment-name>"

ai_daily_request_cap = 50
