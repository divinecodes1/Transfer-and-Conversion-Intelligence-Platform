# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored, which is
# why a personal email address belongs here and not in variables.tf.
#
# Secrets do NOT go in this file even though Terraform would accept them:
#   export TF_VAR_ai_api_key="your-model-provider-key"

# ---- Region -----------------------------------------------------------------
region      = "eu-central-1"
prefix      = "ti"
environment = "student"
owner       = "your-name"

# ---- Budget: set this, it is the only warning you get -----------------------
# AWS does not stop spending when a budget is exceeded. Thresholds fire at
# 50/75/90/100%. Credits are excluded from the calculation so they do not hide
# the gross rate at which the Free Plan balance is being consumed.
monthly_budget_amount          = 15
free_plan_credit_budget_amount = 90
free_plan_expiration_date      = "2027-02-13"
budget_alert_emails   = ["you@university.edu"]

# RDS has no public address. The deployment loads it through a constrained SSM
# document on the Keycloak/NAT instance inside the VPC.

# ---- CI ---------------------------------------------------------------------
# owner/name of this repository. Creates the IAM OIDC provider and the role
# GitHub Actions assumes -- no access key, and no directory administrator
# required, which is what makes CI deployment possible here and not on Azure.
github_repository = "divinecodes1/Transfer-and-Conversion-Intelligence-Platform"

# ---- AI ---------------------------------------------------------------------
# mock needs no key, no credits and no provider account, and every AI surface
# still works. Similarity and delay risk never used a model at all.
ai_provider = "mock"

# Microsoft Foundry's OpenAI v1 endpoint reuses the openai adapter. The model
# value is the Foundry deployment name, not the catalogue model id:
#   ai_provider = "openai"
#   ai_model    = "gpt-oss-120b"
#   ai_base_url = "https://<resource>.openai.azure.com/openai/v1"
#   export TF_VAR_ai_api_key="your-foundry-resource-key"
#
# Groq, or any other OpenAI-compatible endpoint, uses the same adapter:
#   ai_provider = "openai"
#   ai_model    = "openai/gpt-oss-20b"
#   ai_base_url = "https://api.groq.com/openai/v1"
#   export TF_VAR_ai_api_key="your-model-provider-key"

ai_daily_request_cap = 50

# ---- Identity ---------------------------------------------------------------
auth_mode = "enforce"

# Optional SSH key for the Keycloak host. Leave empty: there is no SSH ingress
# rule at all, and SSM Session Manager needs no open port and no key to lose.
#   aws ssm start-session --target $(terraform output -raw keycloak_instance_id)
ssh_public_key = ""

# ---- SMTP -------------------------------------------------------------------
# Gmail works without a domain (use a dedicated account and an App Password).
# For SES sandbox, both sender and recipient addresses must be verified.
smtp_host       = "smtp.gmail.com"
smtp_port       = 587
smtp_from       = "your-verified-address@gmail.com"
smtp_reply_to   = "your-verified-address@gmail.com"
smtp_username   = "your-verified-address@gmail.com"
smtp_auth       = true
smtp_ssl        = false
smtp_starttls   = true
# PowerShell: $env:TF_VAR_smtp_password = "your-app-password"
# Bash:       export TF_VAR_smtp_password="your-app-password"
